# Career Portal Backend - Environment Variables
# Copy this file to .env and update with your values

# Database Configuration
# PostgreSQL (recommended for production)
DATABASE_URL=postgresql://postgres:password@localhost:5432/career_portal

# SQLite fallback (use this if PostgreSQL is not installed)
# DATABASE_URL=sqlite:///./career_portal.db

# JWT Authentication
SECRET_KEY=career-portal-super-secret-key-change-in-production-2024
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
